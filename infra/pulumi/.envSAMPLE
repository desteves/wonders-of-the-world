# MongoDB Atlas project and API credentials
# Project ID: https://cloud.mongodb.com/ (Project Settings > Project Information)
# API keys: https://www.mongodb.com/docs/atlas/configure-api-access/
export MONGODB_ATLAS_PROJECT_ID=""
export MONGODB_ATLAS_PUBLIC_KEY=""
export MONGODB_ATLAS_PRIVATE_KEY=""


# Google Cloud
# Project ID: https://console.cloud.google.com/projectselector2/home/dashboard
# gcloud auth application-default login
# gcloud auth configure-docker gcr.io
export GCP_PROJECT_ID=""
export GCP_REGION=us-central1


# Pulumi local passphrase (used to encrypt config when --local backend is used)
export PULUMI_CONFIG_PASSPHRASE=local
